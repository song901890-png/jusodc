---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import { graph, webPage } from '../lib/schema';

const title = `개인정보·저장 안내 | ${SITE.name}`;
const description = `${SITE.name}는 회원가입이 없고, 즐겨찾기와 최근 방문은 이용자 브라우저에만 저장합니다.`;
const jsonLd = graph(webPage({ path: '/privacy/', name: '개인정보·저장 안내', description }));
---
<Base title={title} description={description} path="/privacy/" jsonLd={jsonLd}>
  <nav class="breadcrumb" aria-label="현재 위치">
    <a href="/">{SITE.name}</a> › <span aria-current="page">개인정보·저장 안내</span>
  </nav>
  <section class="hero">
    <h1>개인정보·저장 안내</h1>
  </section>
  <article class="prose">
    <h2>수집하지 않는 정보</h2>
    <p>{SITE.name}는 회원가입과 로그인이 없으며 이름, 연락처 같은 개인정보를 받지 않습니다.</p>

    <h2>브라우저에만 저장하는 정보</h2>
    <ul>
      <li>즐겨찾기(★)한 사이트 목록</li>
      <li>최근 방문한 사이트 목록(최대 12개)</li>
      <li>방문 횟수와 홈 화면 추가 안내를 닫았는지 여부</li>
    </ul>
    <p>
      이 정보는 이용자 기기의 브라우저 저장소(localStorage)에만 남고 서버로 전송되지 않습니다.
      브라우저의 사이트 데이터를 지우면 함께 삭제됩니다.
    </p>

    <h2>공식 주소 확인기</h2>
    <p>확인기에 입력한 주소는 브라우저 안에서만 비교하며 저장하거나 전송하지 않습니다.</p>

    <h2>접속 통계</h2>
    <p>
      서비스 개선을 위해 방문 수 같은 통계 도구를 도입하게 되면 이 페이지에 도구 이름과 수집 항목을 먼저 알립니다.
      <!-- TODO: GA4·Search Console 등 도입 시 항목 갱신 -->
    </p>

    <h2>문의</h2>
    <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
  </article>
</Base>
