---
import Base from '../layouts/Base.astro';
import Checker from '../components/Checker.astro';
import { SITE } from '../config';
import { sites } from '../lib/data';
import { graph, webPage, breadcrumb } from '../lib/schema';

const title = `공식 주소 확인기 — 받은 링크가 진짜인지 확인 | ${SITE.name}`;
const description = `문자·메신저로 받은 링크를 붙여넣으면 공식 사이트 ${sites.length}곳의 도메인과 비교해 진짜 주소인지, 비슷하게 만든 가짜 의심 주소인지 알려 줍니다.`;
const jsonLd = graph(
  webPage({ path: '/check/', name: '공식 주소 확인기', description }),
  breadcrumb([
    { name: SITE.name, path: '/' },
    { name: '공식 주소 확인기', path: '/check/' },
  ]),
);
---
<Base title={title} description={description} path="/check/" jsonLd={jsonLd}>
  <nav class="breadcrumb" aria-label="현재 위치">
    <a href="/">{SITE.name}</a> › <span aria-current="page">공식 주소 확인기</span>
  </nav>
  <section class="hero">
    <h1>공식 주소 확인기</h1>
    <p class="muted" style="margin:0 0 16px">받은 링크를 붙여넣고 확인하기를 누르세요. 등록된 공식 도메인 {sites.length}곳과 비교합니다.</p>
    <Checker />
  </section>

  <article class="prose">
    <h2>결과는 이렇게 읽으세요</h2>
    <ul>
      <li><strong>공식 주소와 일치</strong> — 등록된 공식 도메인이거나 그 하위 주소입니다. 그래도 로그인·결제 전에는 주소창을 한 번 더 보세요.</li>
      <li><strong>가짜 의심</strong> — 공식 도메인과 철자가 한두 글자 다르거나, 공식 이름을 주소 안에 끼워 넣은 형태입니다. 누르지 말고 목록의 공식 주소로 직접 들어가세요.</li>
      <li><strong>목록에 없는 주소</strong> — 위험하다는 뜻은 아니지만 {SITE.name}가 확인하지 않은 주소입니다. 보낸 곳이 확실할 때만 여세요.</li>
    </ul>

    <h2>사칭 링크에서 자주 보이는 특징</h2>
    <ul>
      <li>naver → naverr, nave-r, rnaver 처럼 글자를 더하거나 바꾼 주소</li>
      <li>l(엘)과 1, o와 0, rn과 m처럼 생김새가 비슷한 글자를 섞은 주소</li>
      <li>naver.com.example.xyz 처럼 공식 이름 뒤에 다른 도메인이 붙은 주소 — 실제 주인은 맨 끝 도메인입니다</li>
      <li>주소 안에 @ 가 들어 있거나, 숫자 IP로 된 주소</li>
      <li>http:// 로 시작해 연결이 암호화되지 않은 주소</li>
    </ul>

    <h2>개인정보는 보내지 않습니다</h2>
    <p>
      확인기는 이 페이지에 함께 내려받은 공식 도메인 목록과 브라우저 안에서만 비교합니다.
      입력한 주소를 서버로 보내거나 기록하지 않으며, 링크에 접속해 보지도 않습니다.
      의심 문자를 받았다면 한국인터넷진흥원 118 상담센터(국번 없이 118)에 신고할 수 있습니다.
    </p>
  </article>
</Base>
