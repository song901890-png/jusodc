---
import Base from '../layouts/Base.astro';
import StatusStrip from '../components/StatusStrip.astro';
import { SITE } from '../config';
import { sites, categories, statusLog, resultOf, STATE_LABEL, displayHost, checkedAt, kstDate } from '../lib/data';
import { graph, webPage, breadcrumb } from '../lib/schema';

const title = `사이트 접속 점검 기록 | ${SITE.name}`;
const description = `${SITE.name}에 등록된 공식 사이트 ${sites.length}곳의 매일 접속 점검 결과와 주소 변경 기록입니다.`;
const date = kstDate(checkedAt);
const nameOf = (id: string) => sites.find((s) => s.id === id)?.name ?? id;
const catName = (slug: string) => categories.find((c) => c.slug === slug)?.short ?? slug;

const jsonLd = graph(
  webPage({ path: '/status/', name: '사이트 접속 점검 기록', description }),
  breadcrumb([
    { name: SITE.name, path: '/' },
    { name: '점검 기록', path: '/status/' },
  ]),
);
---
<Base title={title} description={description} path="/status/" jsonLd={jsonLd}>
  <nav class="breadcrumb" aria-label="현재 위치">
    <a href="/">{SITE.name}</a> › <span aria-current="page">점검 기록</span>
  </nav>
  <section class="hero">
    <h1>사이트 접속 점검 기록</h1>
    <p class="muted" style="margin:0">
      하루 한 번 모든 주소에 자동으로 접속해 응답을 확인합니다. {date ? `마지막 점검: ${date} (한국 시간)` : '아직 첫 자동 점검 전입니다.'}
    </p>
  </section>

  <StatusStrip />

  <article class="prose">
    <h2>최근 변경</h2>
    {statusLog.length === 0 ? (
      <p class="muted">아직 상태가 바뀐 기록이 없습니다.</p>
    ) : (
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">날짜</th><th scope="col">사이트</th><th scope="col">변경</th><th scope="col">메모</th></tr></thead>
          <tbody>
            {statusLog.map((e) => (
              <tr>
                <td>{e.date}</td>
                <td>{nameOf(e.id)}</td>
                <td>{STATE_LABEL[e.from]} → {STATE_LABEL[e.to]}</td>
                <td>{e.note ?? ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <h2>전체 점검 결과</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col">사이트</th><th scope="col">분야</th><th scope="col">주소</th><th scope="col">상태</th><th scope="col">응답</th></tr></thead>
        <tbody>
          {sites.map((s) => {
            const r = resultOf(s.id);
            return (
              <tr>
                <td>{s.name}</td>
                <td>{catName(s.category)}</td>
                <td>{displayHost(s.url)}</td>
                <td>{STATE_LABEL[r.state]}</td>
                <td>{r.code ? `${r.code}${r.ms ? ` · ${r.ms}ms` : ''}` : '—'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <h2>상태 표시 기준</h2>
    <ul>
      <li><strong>정상</strong> — 공식 도메인 안에서 정상 응답(2xx·3xx)을 받았습니다.</li>
      <li><strong>열림 (자동 확인 제한)</strong> — 사이트가 자동 접속을 막아 400·401·403·406·429·451 응답을 줬습니다. 사람이 브라우저로 열면 대부분 정상입니다.</li>
      <li><strong>주소 이동</strong> — 접속하면 등록된 공식 도메인 밖으로 이동합니다. 운영사 공지를 확인한 뒤 목록을 고칩니다.</li>
      <li><strong>연결 안 됨</strong> — 시간 초과, 서버 오류(5xx), 404 등으로 열리지 않았습니다. 같은 날 세 번 확인하고, 이틀 연속 실패할 때만 이렇게 표시합니다.</li>
    </ul>
  </article>
</Base>
