---
import { displayHost, stateOf, STATE_LABEL, type Site } from '../lib/data';

interface Props {
  site: Site;
}
const { site } = Astro.props;
const state = stateOf(site.id);
const host = displayHost(site.url);
---
<li class="card" data-id={site.id}>
  <a href={site.url} target="_blank" rel="nofollow noopener" data-visit={site.id}>
    <span class="fav" aria-hidden="true">{site.name.slice(0, 1)}</span>
    <span class="name">{site.name}</span>
    <span class="host">{host}</span>
  </a>
  <span class="dot" data-state={state} title={`점검 상태: ${STATE_LABEL[state]}`}></span>
  <button class="pin" type="button" data-pin={site.id} aria-pressed="false" aria-label={`${site.name} 즐겨찾기에 고정`}>★</button>
</li>
